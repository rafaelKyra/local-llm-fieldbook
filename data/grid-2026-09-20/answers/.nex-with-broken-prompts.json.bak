   "text": "<answer>```python\n#!/usr/bin/env python3\n\"\"\"Count log levels in files within a directory.\"\"\"\n\nimport argparse\nimport re\nimport sys\nfrom pathlib import Path\n\n\nLEVEL_PATTERN = re.compile(r\"\\b(?:INFO|WARN|ERROR|DEBUG)\\b\")\nLEVELS = (\"INFO\", \"WARN\", \"ERROR\", \"DEBUG\")\n\n\ndef parse_args() -> argparse.Namespace:\n    parser = argparse.ArgumentParser(\n        description=\"Count INFO, WARN, ERROR, and DEBUG occurrences in .log files.\"\n    )\n    parser.add_argument(\"directory\", type=Path, help=\"Directory containing .log files\")\n    parser.add_argument(\n        \"--min-errors\",\n        type=int,\n        default=0,\n        metavar=\"N\",\n        help=\"Only show files containing at least N ERROR occurrences (default: 0)\",\n    )\n    args = parser.parse_args()\n\n    if args.min_errors < 0:\n        parser.error(\"--min-errors must be zero or greater\")\n\n    return args\n\n\ndef count_levels(path: Path) -> dict[str, int]:\n    counts = {level: 0 for level in LEVELS}\n    with path.open(\"r\", encoding=\"utf-8\", errors=\"replace\") as log_file:\n        for line in log_file:\n            for level in LEVEL_PATTERN.findall(line):\n                counts[level] += 1\n    return counts\n\n\ndef print_summary(rows: list[tuple[str, dict[str, int]]]) -> None:\n    headers = (\"file\", *LEVELS)\n    widths = {\n        header: max(len(header), *(len(str(row[1][header])) for row in rows))\n        for header in headers\n    }\n\n    print(\" | \".join(header.ljust(widths[header]) for header in headers))\n    print(\"-+-\".join(\"-\" * widths[header] for header in headers))\n\n    for filename, counts in rows:\n        values = (filename, *(counts[level] for level in LEVELS))\n        print(\" | \".join(str(value).ljust(widths[header]) for value, header in zip(values, headers)))\n\n\ndef main() -> int:\n    args = parse_args()\n\n    if not args.directory.is_dir():\n        print(f\"error: not a directory: {args.directory}\", file=sys.stderr)\n        return 1\n\n    rows = []\n    for path in sorted(args.directory.glob(\"*.log\")):\n        if path.is_file():\n            counts = count_levels(path)\n            if counts[\"ERROR\"] >= args.min_errors:\n                rows.append((path.name, counts))\n\n    print_summary(rows)\n    return 0\n\n\nif __name__ == \"__main__\":\n    raise SystemExit(main())\n```</answer>",
